# thyme bring-up kernel config fragment
#
# Applied on top of arm64 defconfig by the boot-artifacts CI merged
# with scripts/kconfig/merge_config.sh + olddefconfig.  Final .config is
# uploaded as an artifact.  Net effect must be a bootable mainline
# image driving: UFS rootfs-less initramfs, USB DWC3 peripheral gadget,
# USB Ethernet ( ECM primary / NCM fallback* for no-UART bring-up.
#
# Core FS / initramfs
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_RD_GZIP=y
# ( PROC_FS / SYSFS / NET / INET are already y in arm64 defconfig, not repeated*
#
# ConfigFS (for USB gadget function layout*
CONFIG_CONFIGFS_FS=y
#
# USB DWC3 peripheral-controller stack
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
# host-side CDC Ethernet class drivers ( usb0/ECM data path*
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
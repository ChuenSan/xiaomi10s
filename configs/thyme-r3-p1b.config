# R3 P1B minimal mainline entry fragment. Merged on arm64 defconfig +
# thyme-route-b.config (Route B bring-up options retained, not P1B gates).
# CONFIG_INITRAMFS_SOURCE is injected per-build by p1b-build.py pointing at
# the deterministic uncompressed cpio; it is never set here.

CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0

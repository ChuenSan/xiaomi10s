# Route B bring-up fragment (isolated copy of the CI-proven option set).
# Merged on arm64 defconfig via merge_config.sh + olddefconfig.
# Do not edit sm8250-xiaomi-thyme.dts from Route B without a proven boot blocker.

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_RD_GZIP=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y

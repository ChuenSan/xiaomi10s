# R3 P1 contract fragment. Merged on arm64 defconfig + thyme-route-b.config.
# Built-in initramfs path is injected by GHA as CONFIG_INITRAMFS_SOURCE.
# USB options may remain from Route B; they are not a P1 success gate.

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
